FROM node:24-bookworm-slim AS build
ARG PORTAL_ROLE
WORKDIR /app
COPY frontend/package*.json frontend/
RUN cd frontend && npm ci
COPY frontend frontend
COPY scripts/python-assets.cjs scripts/python-assets.cjs
RUN test "$PORTAL_ROLE" = student -o "$PORTAL_ROLE" = teacher -o "$PORTAL_ROLE" = admin
RUN cd frontend && npm run typecheck && npm run build:${PORTAL_ROLE}
RUN node scripts/python-assets.cjs /app/portals/${PORTAL_ROLE}/dist
RUN cp -r /app/portals/${PORTAL_ROLE}/dist /app/site
FROM node:24-bookworm-slim
ARG PORTAL_ROLE
ENV NODE_ENV=production PORTAL_ROLE=${PORTAL_ROLE} HOST=0.0.0.0 PORT=10000 STATIC_DIRECTORY=/app/site
WORKDIR /app
COPY --from=build /app/site site
COPY scripts/portal-server.cjs scripts/portal-server.cjs
USER node
EXPOSE 10000
CMD ["node","scripts/portal-server.cjs"]
