NODE_ENV=production
APP_ORIGIN=https://YOUR-API.onrender.com
APP_ORIGINS=https://YOUR-STUDENT.onrender.com,https://YOUR-TEACHER.onrender.com,https://YOUR-ADMIN.onrender.com
DATABASE_URL=
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=3
NOVA_DEMO_MODE=false

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FREE_ONLY=true
# Optional paid semantic embeddings: requires OPENROUTER_FREE_ONLY=false.
OPENROUTER_EMBEDDING_MODEL=

# Public-reference mode is free. Paid OpenRouter search additionally requires AI_WEB_MODE=openrouter and OPENROUTER_FREE_ONLY=false.
AI_WEB_ENABLED=true
AI_WEB_DOMAINS=docs.python.org,developer.mozilla.org

# One zero-token-price OpenRouter free-router fallback on timeout/temporary failure.
# Set off to keep only the configured primary model. Citations/review remain required.
OPENROUTER_FREE_FALLBACK=on

# Public documentation/Wikipedia retrieval; does not enable paid OpenRouter web plugins.
AI_WEB_MODE=public
