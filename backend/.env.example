# Production template. Supply private values through Liara environment settings.
NODE_ENV=production
NOVA_DEMO_MODE=false
PORT=3000
APP_ORIGIN=https://jahadpythoncourse.ir
DATABASE_URL=
DATABASE_SSL=verify-full
# DATABASE_CA_CERT=
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=/app/backups
# Set AI variables on the separate AI worker; do not use NEXT_PUBLIC_ prefixes.
LIARA_AI_BASE_URL=
LIARA_AI_API_KEY=
LIARA_AI_CHAT_MODEL=
LIARA_AI_EMBEDDING_MODEL=
LIARA_AI_WEB_MODEL=
# Dedicated Docker-enabled grading and AI worker hosts only (never the web app):
NOVA_GRADER_IMAGE=
# Bootstrap only; remove before web startup:
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# Per-process connection budget; use 2 on workers as an initial value.
DATABASE_POOL_MAX=5
DATABASE_APPLICATION_NAME=nova-web
