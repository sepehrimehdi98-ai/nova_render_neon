{
  "name": "nova-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node product-server.js",
    "test": "node --test --test-isolation=none test/passwords.test.js test/platform-database.test.js test/platform-extensions.test.js test/platform-journey.test.js test/platform-learning.test.js test/ai-examples.test.js test/openrouter.test.js",
    "db:migrate": "node scripts/platform-migrate.js",
    "db:check": "node scripts/database-check.js",
    "admin:create": "node scripts/platform-admin.js",
    "admin:recover": "node scripts/platform-admin-recover.js",
    "backup": "node scripts/platform-backup.js backup",
    "restore": "node scripts/platform-backup.js restore",
    "ai:worker": "node scripts/ai-worker.js",
    "grading:worker": "node scripts/grading-worker.js"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
